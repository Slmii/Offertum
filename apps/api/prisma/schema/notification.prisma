// Events the in-app + email notification system can surface to users.
//   - OPPORTUNITY_CREATED  : a new Opportunity was materialized from a classified-positive
//                            RawMessage.
//   - CUSTOMER_REPLY       : an inbound message landed on a tracked thread (status flipped
//                            REPLIED → NEW via attachFollowupMessage).
//   - OPPORTUNITY_AUTO_COLD: the auto-cold scheduler flipped a REPLIED opp to COLD after
//                            the silence-check-in budget ran out + coldAfterDays elapsed.
//                            In-app only — never email (avoids the inbox-loop of W6.2.5).
//   - WEEKLY_DIGEST        : aggregated Monday-morning summary (open opps, cold opps,
//                            pending follow-ups, estimated value).
enum NotificationEventType {
  OPPORTUNITY_CREATED
  CUSTOMER_REPLY
  OPPORTUNITY_AUTO_COLD
  WEEKLY_DIGEST
  DAILY_DIGEST
  // Critical, system-driven: a connected mailbox lost access (refresh token rejected
  // upstream → soft-disconnect). Always delivered on both channels, not user-configurable.
  MAILBOX_ISSUE
}

// Delivery channels for a notification. IN_APP writes a Notification row that the bell
// icon surfaces; EMAIL renders a Resend template and sends to the user's address. Slack
// + Teams are deferred to post-MVP.
enum NotificationChannel {
  IN_APP
  EMAIL
}

// One in-app notification row. Bell icon in the header queries the
// most-recent N rows for the current user. Rows are kept indefinitely; future
// pruning lives in a separate sweeper if the table grows uncomfortably.
//
// `link` is a relative web path the bell-dropdown deep-links to (e.g.
// `/opportunities/<uuid>`). `metadata` is a small Json bag for renderer-specific
// fields (e.g. customer name, deadline) so the dropdown can show a richer
// preview without re-fetching the opportunity.
model Notification {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  organizationId String                @db.Uuid
  eventType      NotificationEventType
  title          String
  body           String                @db.Text
  link           String?
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime              @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Unread-first listing for the bell icon: filters by user + readAt IS NULL
  // ordered by createdAt DESC. Composite index covers both legs.
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([organizationId])
}

// Per-user × per-org × per-event × per-channel opt-in toggle. Missing rows are
// treated as default-enabled at read time (see NotificationService.shouldDeliver).
// Inserting a row is only required to opt OUT — saves a write per (user, event,
// channel) tuple on every signup.
//
// Org-scoped because a user could be in multiple orgs and want different
// noise levels in each (e.g. work org: noisy, personal org: silent).
model NotificationPreference {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  organizationId String                @db.Uuid
  eventType      NotificationEventType
  channel        NotificationChannel
  enabled        Boolean               @default(true)
  updatedAt      DateTime              @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, eventType, channel])
  @@index([organizationId])
}

// Per-user cadence + quiet-hours settings (the "Cadans" card). Distinct from the
// per-event preference matrix: these are scalar and attached to the person, not to a
// membership — one row per user, whatever orgs they belong to.
//
// The times are nonetheless evaluated in the ORG's timezone, because that is the clock
// the digest and the opportunity data are keyed to. Today every org is Europe/Amsterdam
// (see SUPPORTED_TIMEZONE_VALUES), so the distinction is invisible. When a second zone is
// enabled, a user who belongs to orgs in different zones will get each org's notifications
// on that org's clock — decide then whether the setting should carry its own timezone.
// 1:1 with User; a missing row means "use the defaults" (see DEFAULT_NOTIFICATION_SETTINGS
// in @offertum/shared). Times are stored as minutes-from-midnight [0,1439], evaluated in
// the org's timezone at scheduling/dispatch time. The weekly-digest slot is ISO weekday
// (1=Mon..7=Sun) + hour + minute (snapped to the 15-minute cron grid on write).
model NotificationSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  weeklyDigestDay    Int      @default(1)
  weeklyDigestHour   Int      @default(8)
  weeklyDigestMinute Int      @default(0)
  quietHoursEnabled  Boolean  @default(false)
  quietHoursStart    Int      @default(1140)
  quietHoursEnd      Int      @default(450)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per digest actually delivered to a user, for one period. This is the delivery
// claim that makes digest scheduling idempotent: the scheduler asks "is this user's slot
// due and is there no row for this period yet", never "does the slot equal this exact
// tick". That inequality-plus-claim shape is what survives a late tick, a skewed host
// clock, the DST hour that happens twice in October, and the one that does not exist in
// March — all of which an equality match got wrong.
//
// `periodKey` is the ISO week ("2026-W38") for WEEKLY_DIGEST and the calendar day
// ("2026-09-20") for DAILY_DIGEST, computed in the org's timezone. The unique constraint
// is the actual guard; the row is claimed before the send and released if the send throws.
model DigestDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  userId         String                @db.Uuid
  organizationId String                @db.Uuid
  eventType      NotificationEventType
  periodKey      String
  sentAt         DateTime              @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, eventType, periodKey])
  @@index([organizationId, eventType, periodKey])
}
